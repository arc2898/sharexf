  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "8",
  "homepage_url": "/wiki",
  "default_locale": "en",
  "action": {
    "default_title": "__MSG_extensionName__",
    "default_popup": "popup.html",
    "default_icon": {
      "256": "images/sharexf-256.png",
      "128": "images/sharexf-128.png",
      "64": "images/sharexf-64.png",
